# Server
PORT=3000
NODE_ENV=development

# Database
# Railway tự inject DATABASE_URL khi add PostgreSQL plugin
# Local: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=pass -e POSTGRES_DB=caption_app postgres:16
DATABASE_URL=postgresql://user:password@localhost:5432/caption_app

# Security — chuỗi ngẫu nhiên tối thiểu 32 ký tự
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Claude AI (không bắt buộc — nếu thiếu dùng template thay thế)
ANTHROPIC_API_KEY=sk-ant-api03-...

# CORS — domain frontend (ví dụ: https://myapp.railway.app)
ALLOWED_ORIGIN=http://localhost:3000
